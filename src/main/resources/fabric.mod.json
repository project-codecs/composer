{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A lightweight, multi-version Fabric library providing shared systems and utilities for mods built under Project Codex.",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/composer/icon.png",
  "environment": "*",
  "accessWidener": "${aw}.accesswidener",
  "entrypoints": {
    "fabric-datagen": [
      "com.codex.composer.internal.data.ComposerDataGenerator"
    ],
    "client": [
      "com.codex.composer.internal.client.ComposerClient"
    ],
    "main": [
      "com.codex.composer.internal.Composer"
    ]
  },
  "mixins": [
    "composer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": ">=${fapi}",
    "minecraft": "${minecraft}"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ],
      "update_checker": false
    },
    "composer-credits": [
      {
        "after": "-",
        "section": "Composer",
        "disciplines": [
          {
            "discipline": "Development",
            "titles": [
              {
                "title": "Author",
                "names": [
                  "LilBroCodes"
                ]
              }
            ]
          },
          {
            "discipline": "Concept",
            "titles": [
              {
                "title": "Overlay System Idea",
                "names": [
                  "Max (maxmag_change)"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}